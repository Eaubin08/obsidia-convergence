# Ne jamais versionner de secrets, environnements ou configurations locales.
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
id_rsa
id_ed25519
*credentials*
*secrets*
*token*
# Artefacts locaux, bundles, traces et audits bruts.
.git/
*.bundle
*.zip
*.7z
*.tar
*.gz
*.log
*.sqlite
*.sqlite3
node_modules/
.venv/
venv/
__pycache__/
.pytest_cache/
.mypy_cache/
_local_audits/
*.pyc
# Ne pas publier les instantanés bruts directement.
raw_exports/
private_sources/
local_snapshots/
